# Copiar a `.env.local` en la raíz del proyecto (Next.js carga variables automáticamente).

# Secreto para firmar cookies de sesión (mínimo 32 caracteres). Obligatorio en producción.
SESSION_SECRET=genera_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres

DB_HOST=tu_host
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=marketingcolegio

# Monto por defecto al crear pago pendiente (al completar defensa)
PAGO_MONTO_DEFENSA=1

EMAIL_USER=tu_correo@gmail.com
# Contraseña de aplicación de Gmail (16 caracteres, SIN espacios).
# Crear en: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
EMAIL_PASS=abcdefghijklmnop
# Opcional: SMTP personalizado (por defecto smtp.gmail.com:465)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true

# Cloudinary (almacenamiento de evidencias). Crea cuenta en cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
