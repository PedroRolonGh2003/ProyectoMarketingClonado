# Copiar a `.env.local` en la raíz del proyecto (Next.js carga variables automáticamente).

# Secreto para firmar cookies de sesión (mínimo 32 caracteres). Obligatorio en producción.
SESSION_SECRET=genera_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres

DB_HOST=tu_host
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=marketingcolegio

# Monto por defecto al crear pago pendiente (al completar defensa)
PAGO_MONTO_DEFENSA=1

# Correo SMTP (recuperación de contraseña).
# Gmail NO acepta contraseña normal. Usar contraseña de aplicación de 16 caracteres:
# Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_de_16_caracteres
SMTP_FROM="Colegio de Marketing <tu_correo@gmail.com>"
# Compatibilidad legacy (opcional, SMTP_* tiene prioridad): EMAIL_USER y EMAIL_PASS

# Cloudinary (almacenamiento de evidencias). Crea cuenta en cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
